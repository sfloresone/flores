---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "flores",
  description = "Un coding agent construido desde cero, medido antes que escrito.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
