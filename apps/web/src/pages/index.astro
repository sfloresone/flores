---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center gap-6 px-6 py-16">
    <p class="text-sm tracking-wide text-muted uppercase">flores</p>
    <h1 class="text-4xl font-semibold tracking-tight text-ink">
      A coding agent measured before it is written.
    </h1>
    <p class="text-lg leading-relaxed text-muted">
      Benchmarks first, Go agent second. This website will share what we learn
      and the published results; charts will read the JSON files in
      <code class="text-ink">benchmarks/published/</code>, not manually copied figures.
    </p>
    <p>
      <a
        class="text-ink underline underline-offset-4 hover:no-underline"
        href="https://github.com/sfloresone/flores/blob/main/benchmarks/published/README.md"
      >
        Published results in the repository
      </a>
    </p>
  </main>
</BaseLayout>
