---
import FloresBloom from "../components/bloom/FloresBloom.astro";
import { PRESETS } from "../components/bloom/params";
import BaseLayout from "../layouts/BaseLayout.astro";

// Values picked on r3f.maximeheckel.com/dof-fbo (2026-11-05). Their names there:
// frequency 0.15, speedFactor 34.5, fov 0, blur 0.9, focus 6.90.
const bloom = { ...PRESETS.maxime, curl: 0.15, speed: 34.5, fov: 0, blur: 0.9, focus: 6.9 };
---

<BaseLayout>
  <main class="relative h-dvh overflow-hidden bg-night">
    <FloresBloom class="absolute inset-0" params={bloom} />
    <h1
      class="pointer-events-none absolute inset-x-0 top-[12vh] m-0 text-center font-display text-[clamp(3rem,9vw,7.5rem)] leading-none font-normal tracking-[-0.035em] text-cloud"
    >
      Flores
    </h1>
  </main>
</BaseLayout>
