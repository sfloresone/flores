---
/**
 * Flores Bloom: full-bleed particle canvas. Without WebGL2 a static soft glow
 * is shown instead. The engine is bundled with this script (one request): the
 * canvas is the hero, so lazy-loading it would only add a round trip.
 *
 * - `params`: fixed parameters.
 * - `story`: a story from scenes.ts, driven by the page's scroll; the page marks
 *   one element per scene with data-bloom-scene="<name>".
 */
import type { BloomParams } from "./params";
import type { StoryName } from "./scenes";

interface Props {
  params?: Partial<BloomParams>;
  story?: StoryName;
  class?: string;
}

const { params = {}, story, class: className } = Astro.props;
---

<div class:list={["flores-bloom", className]} data-params={JSON.stringify(params)} data-story={story}>
  <canvas aria-hidden="true"></canvas>
</div>

<style>
  /* No position here: unlayered scoped styles would beat the caller's Tailwind
     utilities (`absolute inset-0`). The caller gives the host its size. */
  .flores-bloom {
    display: grid;
  }
  canvas,
  .is-fallback::before {
    grid-area: 1 / 1;
  }
  canvas {
    width: 100%;
    height: 100%;
  }
  /* Static fallback when WebGL2 is not available. */
  .is-fallback::before {
    content: "";
    place-self: center;
    width: min(60vmin, 28rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, #fff3, #fff1 55%, #0000);
    filter: blur(8px);
  }
</style>

<script>
  import { createBloom } from "./engine";
  import { STORIES, type StoryName } from "./scenes";
  import { scrollStory, type Story } from "./story";

  for (const host of document.querySelectorAll<HTMLElement>(".flores-bloom")) {
    const fallback = () => host.classList.add("is-fallback");
    const scenes = host.dataset.story ? STORIES[host.dataset.story as StoryName] : null;
    let story: Story | null = null;
    const bloom = createBloom(
      host.querySelector("canvas")!,
      { ...scenes?.[0]?.params, ...JSON.parse(host.dataset.params!) },
      {
        onFrame: () => story?.update(),
        onError: (error) => {
          console.error(error);
          story?.destroy();
          fallback();
        },
      },
    );
    if (!bloom) fallback();
    else {
      if (scenes) story = scrollStory(bloom, scenes);
      bloom.start();
    }
  }
</script>
